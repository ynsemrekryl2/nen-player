            <array>
                <string>public.movie</string>
                <string>public.audiovisual-content</string>
            </array>
        </dict>
    </array>
    <!-- ADR-0043 Karar 1: the `nenplayer` custom scheme. Format:
         `nenplayer://<medya URL'si birebir>` — parsed in
         `nen_app::handoff::parse_url`. Not verifiable on this machine
         without a Developer ID signature (ADR-0043 Bulgu 9 / roadmap S11);
         the code path exists and is unit-tested regardless. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>player.nen.macos.handoff</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>nenplayer</string>
            </array>
        </dict>
    </array>
</dict>
